# ==============================================================================
# GeoAttend Backend - Environment Variables Template
# ==============================================================================
# IMPORTANT:
# Spring Boot does NOT automatically load this .env file out of the box.
# You must provide these variables through your shell environment, container
# runtime (Render / Docker), or IDE run configuration.
#
# LOCAL QUICKSTART (Linux / macOS):
# 1. Copy this template to create your local .env file (already git-ignored):
#      cp .env.example .env
# 2. Update SPRING_DATASOURCE_PASSWORD and JWT_SECRET with your values.
# 3. Export variables and start the backend:
#      set -a && source .env && set +a && ./mvnw spring-boot:run
# ==============================================================================

# Server Port (Render injects PORT dynamically; defaults to 8080)
PORT=8080

# Database Connection URL:
# For local MySQL:
#   SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/geoattend
# For Neon PostgreSQL (Render deployment):
#   SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-host>/<database>?sslmode=require
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/geoattend

# Database Username:
# For local MySQL: geoattend_user
# For Neon PostgreSQL: your_neon_role_user
SPRING_DATASOURCE_USERNAME=geoattend_user

# Database Password (REQUIRED - No hardcoded fallback)
SPRING_DATASOURCE_PASSWORD=your_database_password_here

# Schema Initialization Mode (Optional - default is 'never' to protect production databases)
# Set to 'always' only when bootstrapping a fresh database
# SPRING_SQL_INIT_MODE=never

# Schema Initializer ApplicationRunner Toggle (Optional - default is 'false' to protect production)
# Set to 'true' only when developing locally or bootstrapping tables via Spring Boot ApplicationRunner
# SCHEMA_INITIALIZER_ENABLED=false

# CORS Allowed Origins (Optional - comma-separated list of authorized frontend URLs)
# Localhost origins (5173, 5174, 5175, 3000) are always allowed automatically.
# Example for Vercel deployment:
# CORS_ALLOWED_ORIGINS=https://geoattend.vercel.app,https://*.vercel.app
CORS_ALLOWED_ORIGINS=https://geoattend.vercel.app

# JWT Signing Secret (REQUIRED - No hardcoded fallback)
# JJWT requires a minimum key size of 256 bits (32 bytes in UTF-8) for HMAC-SHA256.
# Generate a cryptographically secure key with:
#   openssl rand -base64 32
# or
#   openssl rand -hex 32
JWT_SECRET=your_jwt_signing_secret_at_least_32_bytes_long_here

